@startuml sequence-password-reset
' SplitSmart - Account recovery [COND-A] (F-02)
' Sources: design.md section 13.2; contracts/web-api.md section 3.1; decisions.md D-10.
title SplitSmart - Password Reset (uniform response, single-use 30-minute token)

skinparam shadowing false
autonumber

actor "Guest" as G
participant "Browser client" as UI
participant "AuthController" as Ctrl
participant "AccountService" as Acc
participant "EmailRecoveryChannel" as Mail
database "PostgreSQL" as DB

G -> UI : Forgot password (email)
UI -> Ctrl : POST /api/v1/auth/password-reset-requests {email}
Ctrl -> Acc : requestPasswordReset(email)
alt account exists and not rate-limited
  Acc -> DB : invalidate earlier unused tokens;\nINSERT password_reset_token(sha256(token), expires_at = now + 30 min)
  Acc -> Mail : sendResetLink(email, token)
  note right of Mail : link = https://host/reset#token=...\n(fragment: not sent to the server in request lines or logs)
else unknown email or rate-limited
  Acc -> Acc : no-op
end
Ctrl --> UI : 202 Accepted (identical in both cases)

G -> UI : open link, enter new password
UI -> Ctrl : POST /api/v1/auth/password-resets {token, newPassword}
Ctrl -> Acc : completePasswordReset(token, newPassword)
Acc -> DB : find by sha256(token)
alt unknown, expired, or already used
  Acc --> Ctrl : 400 RESET_TOKEN_INVALID
else valid
  Acc -> DB : UPDATE account SET password_hash, password_changed_at = now;\nUPDATE token SET used_at = now;\nINSERT audit_event(PASSWORD_RESET_COMPLETED)
  Acc --> Ctrl : ok
  Ctrl --> UI : 204 (all sessions issued before now are rejected)
end
@enduml
